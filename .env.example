# Example environment variables for local development.
# Export these values before starting the corresponding service.

DATABASE_URL=sqlite:///./roleradar.db
API_BASE_URL=http://127.0.0.1:8000

# OpenAI provider (Stage 7). Never put a real key in this file.
# Copy this file to .env and fill in your own values. .env is gitignored.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OWN_KEY
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
